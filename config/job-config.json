{
    "Name": "top-produce-etl-job-cli",
    "Description": "ETL job for top produce, created via AWS CLI.",
    "Role": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/JustinGlueS3Role",
    "Command": {
      "Name": "glueetl",
      "ScriptLocation": "s3://YOUR_S3_BUCKET_NAME/etl-jobs/top-produce-etl/jobs/job_runner.py",
      "PythonVersion": "3"
    },
    "DefaultArguments": {
      "--job-language": "python",
      "--extra-py-files": "s3://YOUR_S3_BUCKET_NAME/etl-jobs/top-produce-etl/top-produce-etl-v1.0.6.zip",
      "--config_path": "s3://YOUR_S3_BUCKET_NAME/etl-jobs/top-produce-etl/config/config_prod.yaml",
      "--TempDir": "s3://YOUR_S3_BUCKET_NAME/etl-jobs/top-produce-etl/temp/",
      "--job_name_param": "top-produce-etl",
      "_comment": "TODO: Replace YOUR_S3_BUCKET_NAME and YOUR_AWS_ACCOUNT_ID with your actual values before running. 这是 Glue 作业配置，extra-py-files 放自家代码 zip，additional-python-modules 放第三方 wheel.",
      "--enable-continuous-cloudwatch-log": "true",
      "--enable-metrics": "true",
      "--enable-spark-ui": "true"
    },
    "GlueVersion": "4.0",
    "WorkerType": "G.1X",
    "NumberOfWorkers": 2
  }